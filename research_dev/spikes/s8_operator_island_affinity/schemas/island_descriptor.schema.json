{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/island_descriptor.schema.json",
  "title": "Immutable resident operator island descriptor (v1)",
  "$comment": "Self-contained, content-addressed, IMMUTABLE. Leases and request state live in separate schemas. A heterogeneous-attention island sets attention_class=mixed and provides attention_class_by_layer.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "attn": { "type": "string", "enum": ["causal_local_swa", "causal_global", "bidirectional_none", "cross", "not_applicable", "mixed"] },
    "tensorset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tensors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "dtype": { "type": "string" },
              "max_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["name", "dtype", "max_bytes"]
          }
        }
      },
      "required": ["tensors"]
    }
  },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "island_id": { "type": "string", "minLength": 1 },
    "descriptor_hash": { "$ref": "#/$defs/sha256" },
    "service_class": { "type": "string", "enum": ["generation", "rag", "encoder", "background"] },
    "op_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "$ref": "#/$defs/sha256" },
    "graph_hash": { "$ref": "#/$defs/sha256" },
    "layer_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "end": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "n_layer_total": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "required": ["start", "end", "n_layer_total"]
    },
    "attention_class": { "$ref": "#/$defs/attn" },
    "attention_class_by_layer": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["causal_local_swa", "causal_global", "bidirectional_none", "cross", "not_applicable"] }
    },
    "boundary_in": { "$ref": "#/$defs/tensorset" },
    "boundary_out": { "$ref": "#/$defs/tensorset" },
    "weight_set_id": { "$ref": "#/$defs/sha256" },
    "default_state_policy": { "type": "string", "enum": ["stateless", "sticky", "rebuildable"] },
    "supported_routes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+/[A-Za-z0-9_]+$" } },
    "replay_boundary": { "type": "string", "enum": ["token_history", "stage_input"] }
  },
  "required": [
    "schema_version", "island_id", "descriptor_hash", "service_class",
    "op_classes", "model_id", "model_version", "graph_hash", "layer_range",
    "attention_class", "boundary_in", "boundary_out", "weight_set_id",
    "default_state_policy", "supported_routes", "replay_boundary"
  ],
  "allOf": [
    {
      "if": { "properties": { "attention_class": { "const": "mixed" } }, "required": ["attention_class"] },
      "then": { "required": ["attention_class_by_layer"] }
    }
  ]
}
