{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/artifact_manifest.schema.json",
  "title": "Simulator / atlas / normalize run artifact manifest (v1)",
  "$comment": "Self-contained. Wraps one run for reproducibility and carries the full hash-binding set: every input+output hash, code + config hash, and (for normalize runs) the sidecar-manifest hash. Two runs with identical inputs+seed reproduce deterministic_replay_sha256.",
  "type": "object",
  "additionalProperties": false,
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["atlas", "oracle", "normalize"] },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "required": ["role", "path", "sha256"]
      }
    },
    "code_version": { "$ref": "#/$defs/sha256" },
    "config_hash": { "$ref": "#/$defs/sha256" },
    "seed": { "type": ["integer", "null"] },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "sidecar_manifest_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$", "description": "for normalize outputs: hash of the trace sidecar manifest bound to this output" }
        },
        "required": ["path", "sha256"]
      }
    },
    "deterministic_replay_sha256": { "$ref": "#/$defs/sha256" },
    "gate_results": { "type": "object" }
  },
  "required": ["schema_version", "run_id", "kind", "inputs", "code_version", "config_hash", "outputs", "deterministic_replay_sha256"],
  "allOf": [
    {
      "$comment": "kind=normalize must bind at least one output, each carrying a non-null sidecar_manifest_sha256",
      "if": { "properties": { "kind": { "const": "normalize" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": { "required": ["sidecar_manifest_sha256"], "properties": { "sidecar_manifest_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } }
          }
        }
      }
    }
  ]
}
