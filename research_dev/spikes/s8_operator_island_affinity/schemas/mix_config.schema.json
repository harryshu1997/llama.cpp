{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/mix_config.schema.json",
  "title": "Deterministic mix-v1 composition config (v1)",
  "$comment": "Self-contained. Commits the frozen mix-v1 stream parameters (rank, per-stream integer time map, committed component hashes). Composition is by EXPLICIT committed integer offsets; no PRNG, no seed. See NORMALIZATION_SPEC section 7.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "provenance": { "type": "string", "const": "semi_synthetic" },
    "mix_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "streams": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "source": { "type": "string", "minLength": 1 },
          "source_revision": { "type": "string", "minLength": 1 },
          "component_trace": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.jsonl$" },
          "scale_num": { "type": "integer", "minimum": 1 },
          "scale_den": { "type": "integer", "minimum": 1 },
          "offset_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "input_output_sha256": { "$ref": "#/$defs/sha256" },
          "input_manifest_sha256": { "$ref": "#/$defs/sha256" }
        },
        "required": [
          "rank", "source", "source_revision", "component_trace",
          "scale_num", "scale_den", "offset_us",
          "input_output_sha256", "input_manifest_sha256"
        ]
      }
    }
  },
  "required": ["schema_version", "provenance", "mix_id", "streams"]
}
