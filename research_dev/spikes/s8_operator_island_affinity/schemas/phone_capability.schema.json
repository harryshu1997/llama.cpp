{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/phone_capability.schema.json",
  "title": "Phone / device / backend capability (v1)",
  "$comment": "Self-contained. Slow-changing capability, distinct from fast telemetry. Staleness uses receiver time (telemetry schema).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "serial": { "type": "string" },
    "soc": { "type": "string" },
    "backend_id": { "type": "string", "enum": ["HTP0", "GPUOpenCL", "CPU"] },
    "opt_arch": { "type": ["integer", "null"] },
    "disk_free_bytes": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "ram_usable_ceiling_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "supported_op_classes": { "type": "array", "items": { "type": "string" } },
    "ready_manifest_epoch": { "type": ["integer", "null"], "minimum": 0 },
    "cache_digest": { "type": ["string", "null"] }
  },
  "required": ["schema_version", "device_id", "soc", "backend_id", "ram_usable_ceiling_bytes", "supported_op_classes"]
}
