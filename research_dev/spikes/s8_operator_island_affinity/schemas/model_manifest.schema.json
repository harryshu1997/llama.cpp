{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/model_manifest.schema.json",
  "title": "Model / shard manifest (v1)",
  "$comment": "Self-contained. A shard with a null/absent sha256 or bytes cannot make any island READY.",
  "type": "object",
  "additionalProperties": false,
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "$ref": "#/$defs/sha256" },
    "source_hash": { "$ref": "#/$defs/sha256" },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shard_id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "layer_range": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": { "type": "integer", "minimum": 0, "maximum": 100000 },
              "end": { "type": "integer", "minimum": 1, "maximum": 100000 },
              "n_layer_total": { "type": "integer", "minimum": 1, "maximum": 100000 }
            },
            "required": ["start", "end", "n_layer_total"]
          }
        },
        "required": ["shard_id", "file", "bytes", "sha256", "layer_range"]
      }
    },
    "graph_hash": { "$ref": "#/$defs/sha256" },
    "required_backends": { "type": "array", "items": { "type": "string" } },
    "resident_ram_estimate_bytes": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "warmup_cmd": { "type": "string" },
    "compatible_soc": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema_version", "model_id", "model_version", "source_hash", "shards", "graph_hash", "required_backends"]
}
