{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/dag_cover.schema.json",
  "title": "DAG island cover (v1)",
  "$comment": "Self-contained. Non-overlapping partition of a service DAG into islands. partition_valid is asserted by the tool (union==all nodes AND pairwise disjoint); JSON Schema cannot express the cross-item partition check.",
  "type": "object",
  "additionalProperties": false,
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "cover_id": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "service_dag_hash": { "$ref": "#/$defs/sha256" },
    "islands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "island_id": { "type": "string", "minLength": 1 },
          "island_descriptor_ref": { "$ref": "#/$defs/sha256" },
          "member_node_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "boundary_in_edges": { "type": "array", "items": { "type": "string" } },
          "boundary_out_edges": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["island_id", "island_descriptor_ref", "member_node_ids", "boundary_in_edges", "boundary_out_edges"]
      }
    },
    "partition_valid": { "type": "boolean" }
  },
  "required": ["schema_version", "cover_id", "service", "service_dag_hash", "islands", "partition_valid"]
}
