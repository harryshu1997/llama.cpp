{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/request_state_lease.schema.json",
  "title": "Request-state lease (v1, FAST loop) -- DRAFT-BLOCKED-BEFORE-V0c",
  "$comment": "Self-contained. DRAFT-BLOCKED-BEFORE-V0c: mutation sequence/idempotency and stale-completion rejection semantics are unresolved (see DECISION_CONTRACT). One request's KV/state on one owner; depends on a READY model-residency lease; no hot KV migration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "status_block": { "type": "string", "const": "DRAFT_BLOCKED_BEFORE_V0C" },
    "request_id": { "type": "string", "minLength": 1 },
    "route_epoch": { "type": "integer", "minimum": 0 },
    "lease_epoch": { "type": "integer", "minimum": 0 },
    "seq_slot_epoch": { "type": "integer", "minimum": 0 },
    "depends_on_residency_lease_id": { "type": "string", "minLength": 1 },
    "depends_on_residency_epoch": { "type": "integer", "minimum": 0 },
    "device_backend_id": { "type": "string", "pattern": "^[A-Za-z0-9_]+/[A-Za-z0-9_]+$" },
    "island_id": { "type": "string", "minLength": 1 },
    "state_owner": { "type": "string", "pattern": "^[A-Za-z0-9_]+/[A-Za-z0-9_]+$" },
    "state_bytes": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "granted_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expiry_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "status": { "type": "string", "enum": ["granted", "active", "draining", "released", "expired", "error"] },
    "replay_boundary": { "type": "string", "enum": ["token_history", "stage_input"] }
  },
  "required": ["schema_version", "status_block", "request_id", "route_epoch", "lease_epoch", "seq_slot_epoch", "depends_on_residency_lease_id", "depends_on_residency_epoch", "device_backend_id", "island_id", "state_owner", "granted_us", "expiry_us", "status", "replay_boundary"]
}
