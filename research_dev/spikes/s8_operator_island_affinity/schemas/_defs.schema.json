{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/_defs.schema.json",
  "title": "Shared definitions catalog (v1) -- INFORMATIVE ONLY",
  "$comment": "INFORMATIVE catalog of the shared field shapes. It is NOT referenced by any record schema: each record schema INLINES the definitions it needs so it validates standalone from its filesystem path under jsonschema 4.10.3 and ajv-cli@5 with no preloaded/-r schemas. Keep this file in sync by hand when a shared shape changes. This schema is itself self-contained and validates any instance (a $defs-only schema constrains nothing).",
  "$defs": {
    "schema_version": { "type": "integer", "const": 1 },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "us_int": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "bytes_int": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "token_count": { "type": "integer", "minimum": 0, "maximum": 100000000 },
    "modality_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "epoch": { "type": "integer", "minimum": 0 },
    "provenance": { "type": "string", "enum": ["real", "real_decomposed", "semi_synthetic", "synthetic"] },
    "field_provenance": { "type": "string", "enum": ["none", "synthetic"] },
    "device_backend_id": { "type": "string", "pattern": "^[A-Za-z0-9_]+/[A-Za-z0-9_]+$" },
    "attention_class": { "type": "string", "enum": ["causal_local_swa", "causal_global", "bidirectional_none", "cross", "not_applicable", "mixed"] },
    "reason_code": { "type": "string", "enum": ["unsupported", "not_resident", "state_pinned", "no_slack", "transfer_dominated", "thermal", "stale", "insufficient_ram", "interference", "credits_exhausted", "server_cheaper", "capacity_relief", "energy_gain"] },
    "profile_verdict": { "type": "string", "enum": ["PASS", "LOWER_BOUND", "UNSUPPORTED", "SYNTHETIC_UNCERTIFIED", "FAIL", "UNKNOWN"] }
  }
}
