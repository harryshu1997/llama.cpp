{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s8/schemas/request.schema.json",
  "title": "Normalized trace request event (v1)",
  "$comment": "Self-contained: only local #/$defs refs, validates standalone under jsonschema 4.10.3 and ajv-cli@5 --spec=draft2020 with no preloaded schemas. schema_version is the single version authority (no trace_version). provenance value is semi_synthetic (never semi_synthetic_mix).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "provenance": { "type": "string", "enum": ["real", "real_decomposed", "semi_synthetic", "synthetic"] },
    "t_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "service": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model_class": { "type": "string", "minLength": 1, "maxLength": 128 },
    "session_id": { "type": ["string", "null"], "maxLength": 512 },
    "input_tokens": { "type": "integer", "minimum": 0, "maximum": 100000000 },
    "output_tokens": { "type": "integer", "minimum": 0, "maximum": 100000000 },
    "images": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "audio_ms": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "retrieved_chunks": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "cache_keys": { "type": "array", "maxItems": 4096, "items": { "type": "string", "maxLength": 256 } },
    "observed_latency_us": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "priority_class": { "type": ["string", "null"], "maxLength": 64 },
    "deadline_us": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "priority_provenance": { "type": "string", "enum": ["none", "synthetic"] },
    "deadline_provenance": { "type": "string", "enum": ["none", "synthetic"] },
    "source_fields": {
      "type": "object",
      "description": "verbatim passthrough; deterministic JSON-safe scalars only (string/integer/boolean/null); no floats, arrays, or nested objects",
      "additionalProperties": { "type": ["string", "integer", "boolean", "null"] }
    }
  },
  "required": [
    "schema_version", "event_id", "source", "provenance", "t_us",
    "service", "model_class", "session_id", "input_tokens", "output_tokens",
    "images", "audio_ms", "retrieved_chunks", "cache_keys",
    "observed_latency_us", "priority_class", "deadline_us",
    "priority_provenance", "deadline_provenance", "source_fields"
  ],
  "allOf": [
    {
      "$comment": "bidirectional: deadline_us null iff provenance none; integer iff synthetic",
      "oneOf": [
        { "properties": { "deadline_provenance": { "const": "none" }, "deadline_us": { "type": "null" } } },
        { "properties": { "deadline_provenance": { "const": "synthetic" }, "deadline_us": { "type": "integer" } } }
      ]
    },
    {
      "$comment": "bidirectional: priority_class null iff provenance none; string iff synthetic",
      "oneOf": [
        { "properties": { "priority_provenance": { "const": "none" }, "priority_class": { "type": "null" } } },
        { "properties": { "priority_provenance": { "const": "synthetic" }, "priority_class": { "type": "string", "minLength": 1 } } }
      ]
    }
  ]
}
