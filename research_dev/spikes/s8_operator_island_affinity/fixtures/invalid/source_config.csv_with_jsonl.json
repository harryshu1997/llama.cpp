    "url": "https://github.com/HPMLL/BurstGPT/releases/download/v2.0/BurstGPT_3.csv"
  },
  "provenance": "real",
  "schema_version": 1,
  "source": "burstgpt-v2",
  "timestamp": {
    "field": "Timestamp",
    "grammar": "^[0-9]+\\.[0-9]+$",
    "overflow_max": 9007199254740991,
    "policy": "require_nondecreasing",
    "to_us": "decimal_round_half_up_1e6",
