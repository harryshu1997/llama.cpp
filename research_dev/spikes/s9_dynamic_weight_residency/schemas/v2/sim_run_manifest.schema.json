{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s9/schemas/v2/sim_run_manifest.schema.json",
  "title": "Residency simulator run manifest (v2)",
  "$comment": "Self-contained. Wraps one repaired-simulator run for reproducibility. deterministic_replay_sha256 = SHA-256 over the canonical-JSON of goodput_results; same config_hash + code_version + seed reproduces it byte-identically. Each baseline result carries the FIVE terminal-outcome buckets (completed_phone/completed_server/fallback/rejected/timed_out); the loader must find requests == the sum of those buckets (checked in-sim and re-checked by the test harness). fixtures_only MUST be true in S9-V0-R (no real-trace results until S8 Gate A is confirmed).",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "u53": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "i53": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "kind": { "type": "string", "const": "residency_sim" },
    "fixtures_only": { "type": "boolean", "const": true },
    "config_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "config_hash": { "$ref": "#/$defs/sha256" },
    "code_version": { "$ref": "#/$defs/sha256" },
    "seed": { "$ref": "#/$defs/u53" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "required": ["role", "path", "sha256"]
      }
    },
    "goodput_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "goodput_bytes_per_s": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "baselines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "policy": { "type": "string", "enum": ["server_only", "per_request_fetch", "static_placement", "lru", "lfu_ttl", "fastest_ready", "relief_predictive", "clairvoyant"] },
                "is_upper_bound": { "type": "boolean" },
                "is_diagnostic_losing": { "type": "boolean" },
                "requests": { "$ref": "#/$defs/u53" },
                "completed_phone": { "$ref": "#/$defs/u53" },
                "completed_server": { "$ref": "#/$defs/u53" },
                "fallback": { "$ref": "#/$defs/u53" },
                "rejected": { "$ref": "#/$defs/u53" },
                "timed_out": { "$ref": "#/$defs/u53" },
                "dispatched_to_phone": { "$ref": "#/$defs/u53" },
                "dispatched_by_device": { "type": "object", "additionalProperties": { "$ref": "#/$defs/u53" } },
                "weight_misses": { "$ref": "#/$defs/u53" },
                "server_gpu_us_used": { "$ref": "#/$defs/u53" },
                "server_gpu_us_freed": { "$ref": "#/$defs/u53" },
                "server_hbm_bytes_freed": { "$ref": "#/$defs/u53" },
                "transfer_bytes": { "$ref": "#/$defs/u53" },
                "retry_bytes": { "$ref": "#/$defs/u53" },
                "d2h_bytes": { "$ref": "#/$defs/u53" },
                "ufs_bytes": { "$ref": "#/$defs/u53" },
                "prepare_us_total": { "$ref": "#/$defs/u53" },
                "evictions": { "$ref": "#/$defs/u53" },
                "stale_pipeline_drops": { "$ref": "#/$defs/u53" },
                "stale_completion_rejects": { "$ref": "#/$defs/u53" },
                "prefetch_drops": { "$ref": "#/$defs/u53" },
                "oversub_rollbacks": { "$ref": "#/$defs/u53" },
                "deadline_hits": { "$ref": "#/$defs/u53" },
                "deadline_misses": { "$ref": "#/$defs/u53" },
                "completion_p50_us": { "$ref": "#/$defs/u53" },
                "completion_p95_us": { "$ref": "#/$defs/u53" },
                "objective_relief_us_total": { "$ref": "#/$defs/i53" },
                "objective_cost_us_total": { "$ref": "#/$defs/i53" },
                "waited_for_weights": { "$ref": "#/$defs/u53" }
              },
              "required": ["policy", "is_upper_bound", "is_diagnostic_losing", "requests", "completed_phone", "completed_server", "fallback", "rejected", "timed_out", "dispatched_to_phone", "dispatched_by_device", "weight_misses", "server_gpu_us_used", "server_gpu_us_freed", "server_hbm_bytes_freed", "transfer_bytes", "retry_bytes", "d2h_bytes", "ufs_bytes", "prepare_us_total", "evictions", "stale_pipeline_drops", "stale_completion_rejects", "prefetch_drops", "oversub_rollbacks", "deadline_hits", "deadline_misses", "completion_p50_us", "completion_p95_us", "objective_relief_us_total", "objective_cost_us_total", "waited_for_weights"]
            }
          }
        },
        "required": ["goodput_bytes_per_s", "baselines"]
      }
    },
    "deterministic_replay_sha256": { "$ref": "#/$defs/sha256" },
    "gate_results": { "type": "object" }
  },
  "required": ["schema_version", "run_id", "kind", "fixtures_only", "config_id", "config_hash", "code_version", "seed", "inputs", "goodput_results", "deterministic_replay_sha256"]
}
