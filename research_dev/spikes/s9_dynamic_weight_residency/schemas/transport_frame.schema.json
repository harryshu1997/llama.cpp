{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s9/schemas/transport_frame.schema.json",
  "title": "Transport frame descriptor (v1)",
  "$comment": "Self-contained and FAIL-CLOSED. Describes one bounded, versioned, checksummed frame on either the control or bulk channel (net-new; it must NOT reuse LayerSplit or ggml-rpc framing). payload_bytes has a hard maximum (16 MiB); a control frame is further capped at 65536 (if/then). A bulk frame (channel==bulk) MUST carry a payload_sha256 and msg_type==BULK_CHUNK. priority_class encodes preemption: activation/result/control outrank bulk_weight_background on the wire, so activation traffic preempts background prefetch (msg_type<->priority binding via if/then). Every frame carries the epoch stack (boot/residency/route/state) and a monotone seq + idempotency_key so a duplicate or reordered or stale-epoch frame is rejected fail-closed by the reader.",
  "type": "object",
  "additionalProperties": false,
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "magic": { "type": "string", "const": "S9WR" },
    "protocol_version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "channel": { "type": "string", "enum": ["control", "bulk"] },
    "msg_type": { "type": "string", "enum": ["HELLO", "CACHE_QUERY", "FETCH", "VERIFY", "LOAD", "WARM", "READY", "LEASE", "RELEASE", "ALLOC_STATE", "FREE_STATE", "RESET_STATE", "EXECUTE", "RESULT", "CREDIT", "HEARTBEAT", "DRAIN", "ERROR", "CLOSE", "BULK_CHUNK"] },
    "priority_class": { "type": "string", "enum": ["control", "activation", "result", "bulk_weight_background"] },
    "header_len": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "payload_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216, "description": "hard upper bound = 16 MiB; control frames further capped at 65536" },
    "header_crc32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "payload_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "request_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "monotone per (connection, channel); a gap or repeat is rejected" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "boot_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "residency_epoch": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "route_epoch": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "state_epoch": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "deadline_us": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "cancellable": { "type": "boolean" }
  },
  "required": ["schema_version", "magic", "protocol_version", "channel", "msg_type", "priority_class", "header_len", "payload_bytes", "header_crc32", "payload_sha256", "request_id", "seq", "idempotency_key", "boot_epoch", "residency_epoch", "route_epoch", "state_epoch", "deadline_us", "cancellable"],
  "allOf": [
    {
      "$comment": "control channel: small frame cap, no bulk payload",
      "if": { "properties": { "channel": { "const": "control" } }, "required": ["channel"] },
      "then": {
        "properties": {
          "payload_bytes": { "maximum": 65536 },
          "priority_class": { "enum": ["control", "activation", "result"] },
          "msg_type": { "not": { "const": "BULK_CHUNK" } }
        }
      }
    },
    {
      "$comment": "bulk channel: only BULK_CHUNK, always content-hashed, background priority",
      "if": { "properties": { "channel": { "const": "bulk" } }, "required": ["channel"] },
      "then": {
        "properties": {
          "msg_type": { "const": "BULK_CHUNK" },
          "priority_class": { "const": "bulk_weight_background" },
          "payload_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    {
      "$comment": "activation/result carry live data and must be preemptive priority, never background",
      "if": { "properties": { "msg_type": { "enum": ["EXECUTE", "RESULT"] } }, "required": ["msg_type"] },
      "then": { "properties": { "priority_class": { "enum": ["activation", "result"] } } }
    }
  ]
}
