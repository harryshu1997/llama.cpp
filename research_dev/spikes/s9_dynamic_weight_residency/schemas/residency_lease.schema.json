{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s9/schemas/residency_lease.schema.json",
  "title": "Residency lease (slow loop) (v1)",
  "$comment": "Self-contained. Leases a READY weight set's RESIDENCY on one (device, backend) for a horizon; shared by many requests. It requires an existing ReadyCertificate (ready_certificate_id/digest always present) and carries residency_generation + boot_epoch + share_registry_generation. min_hold_us is the hysteresis floor that prevents per-request thrash. A DRAINING lease must complete a backend fence before EVICTING (enforced by the lease state machine, not the schema). horizon.end_us must exceed horizon.start_us and the min-hold floor (semantic check).",
  "type": "object",
  "additionalProperties": false,
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "residency_lease_id": { "type": "string", "minLength": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "backend": { "type": "string", "enum": ["htp", "gpu"] },
    "weight_set_id": { "type": "string", "minLength": 1 },
    "weight_set_digest": { "$ref": "#/$defs/sha256" },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "$ref": "#/$defs/sha256" },
    "boot_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "residency_generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "share_registry_generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "ready_certificate_id": { "type": "string", "minLength": 1 },
    "ready_certificate_digest": { "$ref": "#/$defs/sha256" },
    "state": { "type": "string", "enum": ["READY", "LEASED", "DRAINING", "EVICTING", "ERROR", "QUARANTINED"] },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "end_us": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "required": ["start_us", "end_us"]
    },
    "min_hold_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "reserved_bytes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weights": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "derived": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "scratch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["weights", "derived", "scratch"]
    }
  },
  "required": ["schema_version", "residency_lease_id", "device_id", "backend", "weight_set_id", "weight_set_digest", "model_id", "model_version", "boot_epoch", "residency_generation", "share_registry_generation", "ready_certificate_id", "ready_certificate_digest", "state", "horizon", "min_hold_us", "reserved_bytes"]
}
