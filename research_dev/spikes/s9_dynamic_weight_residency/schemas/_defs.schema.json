{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s9/schemas/_defs.schema.json",
  "title": "S9 shared definitions catalog (v1) -- INFORMATIVE ONLY",
  "$comment": "INFORMATIVE catalog of shared field shapes. NOT referenced by any record schema: each record schema INLINES the definitions it needs so it validates standalone from its filesystem path under jsonschema 4.10.3 and ajv-cli@5 with no preloaded/-r schemas. Keep in sync by hand. A $defs-only schema constrains nothing, so this file validates any instance.",
  "$defs": {
    "schema_version": { "type": "integer", "const": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "us_int": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "bytes_int": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "backend": { "type": "string", "enum": ["htp", "gpu", "cpu"] },
    "image_class": { "type": "string", "enum": ["htp_linear", "gpu_plain", "gpu_xmem_prepacked"] },
    "soc": { "type": "string", "enum": ["op12", "op15"] },
    "dtype": { "type": "string", "enum": ["f16", "f32", "bf16"] },
    "weightset_state": {
      "type": "string",
      "enum": ["ABSENT", "RECEIVING", "VERIFYING", "VERIFIED_ON_DISK", "MATERIALIZING", "LPDDR_READY", "PREPARING_HTP", "PREPARING_GPU", "WARMING", "READY_HTP", "READY_GPU", "ERROR", "QUARANTINED"]
    },
    "lease_state": { "type": "string", "enum": ["READY", "LEASED", "DRAINING", "EVICTING", "ERROR", "QUARANTINED"] },
    "correctness_verdict": { "type": "string", "enum": ["pass", "fail", "blocked", "unknown"] },
    "priority_class": { "type": "string", "enum": ["control", "activation", "result", "bulk_weight_background"] },
    "channel": { "type": "string", "enum": ["control", "bulk"] },
    "state_policy": { "type": "string", "enum": ["stateless", "sticky", "rebuildable"] },
    "reason_code": {
      "type": "string",
      "enum": ["dispatch_ok", "unsupported_backend", "not_resident", "partial_on_disk", "state_pinned", "no_slack", "transfer_dominated", "thermal", "stale_epoch", "insufficient_ram", "interference", "credits_exhausted", "server_cheaper", "capacity_relief", "hash_mismatch", "unknown_profile", "duplicate_message", "reordered_message", "lease_expired", "quarantined"]
    },
    "msg_type": {
      "type": "string",
      "enum": ["HELLO", "CACHE_QUERY", "FETCH", "VERIFY", "LOAD", "WARM", "READY", "LEASE", "RELEASE", "ALLOC_STATE", "FREE_STATE", "RESET_STATE", "EXECUTE", "RESULT", "CREDIT", "HEARTBEAT", "DRAIN", "ERROR", "CLOSE", "BULK_CHUNK"]
    },
    "layer_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "end": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "n_layer_total": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "required": ["start", "end", "n_layer_total"]
    }
  }
}
