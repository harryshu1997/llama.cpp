{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s9/schemas/v5/bundle.schema.json",
  "title": "S9-V0-R record bundle envelope (v5)",
  "$comment": "Self-contained v5 envelope. The strict bundle validator selects every record's v5 schema, recomputes its digest, checks cross-record links, and rejects unknown versions, duplicate keys, malformed records, missing records, and mismatched identities. bundle_version is const 5, so older record sets cannot be reinterpreted under v5 rules.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "kind": {
      "type": "string",
      "const": "bundle"
    },
    "bundle_version": {
      "type": "integer",
      "const": 5
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "kind",
          "schema_version"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "bundle_version",
    "bundle_id",
    "records"
  ]
}
