{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/s9/schemas/v5/state_lease.schema.json",
  "title": "State lease (fast loop) (v5)",
  "$comment": "Fast-loop ownership of one request's mutable state. It depends on one residency generation and carries route, lease, slot, and mutation epochs. The v5 digest binds every schema-allowed identity, epoch, policy, and reservation field.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "kind": {
      "type": "string",
      "const": "state_lease"
    },
    "state_lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "backend": {
      "type": "string",
      "enum": [
        "htp",
        "gpu"
      ]
    },
    "island_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "boot_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "route_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seq_slot_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "depends_on_residency_lease_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "depends_on_residency_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state_policy": {
      "type": "string",
      "enum": [
        "stateless",
        "sticky",
        "rebuildable"
      ]
    },
    "reserved_state_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reserved_activation_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "in_flight_mutation_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state_lease_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "state_lease_id",
    "request_id",
    "device_id",
    "backend",
    "island_id",
    "boot_epoch",
    "route_epoch",
    "lease_epoch",
    "seq_slot_epoch",
    "depends_on_residency_lease_id",
    "depends_on_residency_generation",
    "state_policy",
    "reserved_state_bytes",
    "reserved_activation_bytes",
    "in_flight_mutation_seq",
    "state_lease_digest"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state_policy": {
            "const": "stateless"
          }
        },
        "required": [
          "state_policy"
        ]
      },
      "then": {
        "properties": {
          "reserved_state_bytes": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state_policy": {
            "const": "sticky"
          }
        },
        "required": [
          "state_policy"
        ]
      },
      "then": {
        "properties": {
          "reserved_state_bytes": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state_policy": {
            "const": "rebuildable"
          }
        },
        "required": [
          "state_policy"
        ]
      },
      "then": {
        "properties": {
          "reserved_state_bytes": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
