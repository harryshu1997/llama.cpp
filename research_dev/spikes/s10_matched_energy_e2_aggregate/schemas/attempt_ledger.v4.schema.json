{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s10-e2a-attempt-ledger-v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "ledger_id",
    "chain_id",
    "set_id",
    "plan_sha256",
    "entries",
    "head_sha256",
    "record_sha256"
  ],
  "$defs": {
    "ident": {"type": "string", "minLength": 1, "maxLength": 256,
              "pattern": "^[\\x21-\\x7e]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullable_sha256": {
      "oneOf": [{"type": "null"}, {"type": "string",
                                   "pattern": "^[0-9a-f]{64}$"}]
    },
    "nullable_ident": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1,
                                   "maxLength": 256,
                                   "pattern": "^[\\x21-\\x7e]+$"}]
    },
    "nullable_uint": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/uint"}]
    }
  },
  "properties": {
    "schema_version": {"const": 4},
    "kind": {"const": "AttemptLedger"},
    "ledger_id": {"$ref": "#/$defs/ident"},
    "chain_id": {"$ref": "#/$defs/ident"},
    "set_id": {"$ref": "#/$defs/ident"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "prev_entry_sha256", "entry_kind", "slot_index",
                     "attempt_ordinal", "monotonic_us", "clock_epoch_id",
                     "status", "reason_code", "run_nonce", "timeline_id",
                     "plan_anchor_record_sha256", "timeline_record_sha256",
                     "lifecycle_record_sha256",
                     "request_outcome_record_sha256", "window_start_us",
                     "window_end_us", "drain_acknowledged_us",
                     "entry_sha256"],
        "properties": {
          "seq": {"$ref": "#/$defs/uint"},
          "prev_entry_sha256": {"$ref": "#/$defs/sha256"},
          "entry_kind": {
            "enum": ["PLAN_ANCHOR", "SLOT_OPEN", "SLOT_ATTEMPT_START",
                     "SLOT_ATTEMPT_END", "SET_SEAL"]
          },
          "slot_index": {"type": "integer", "minimum": -1,
                         "maximum": 9007199254740991},
          "attempt_ordinal": {"$ref": "#/$defs/uint"},
          "monotonic_us": {"$ref": "#/$defs/uint"},
          "clock_epoch_id": {"$ref": "#/$defs/ident"},
          "status": {
            "enum": ["OK", "FAILED", "CANCELED", "CRASHED", "INELIGIBLE",
                     "ABORTED_BY_GATE"]
          },
          "reason_code": {"$ref": "#/$defs/ident"},
          "run_nonce": {"$ref": "#/$defs/nullable_ident"},
          "timeline_id": {"$ref": "#/$defs/nullable_ident"},
          "plan_anchor_record_sha256": {"$ref": "#/$defs/nullable_sha256"},
          "timeline_record_sha256": {"$ref": "#/$defs/nullable_sha256"},
          "lifecycle_record_sha256": {"$ref": "#/$defs/nullable_sha256"},
          "request_outcome_record_sha256": {"$ref": "#/$defs/nullable_sha256"},
          "window_start_us": {"$ref": "#/$defs/nullable_uint"},
          "window_end_us": {"$ref": "#/$defs/nullable_uint"},
          "drain_acknowledged_us": {"$ref": "#/$defs/nullable_uint"},
          "entry_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "head_sha256": {"$ref": "#/$defs/sha256"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  }
}
