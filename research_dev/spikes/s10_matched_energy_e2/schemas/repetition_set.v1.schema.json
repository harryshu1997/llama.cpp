{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s10-e2-repetition-set-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "set_id",
    "declared_order",
    "order_digest",
    "aggregate_method",
    "warmup_timelines",
    "attempted_pairs",
    "pairs",
    "scope",
    "instrument_kind",
    "aggregate_result_label",
    "reason_code",
    "record_sha256"
  ],
  "$defs": {
    "ident": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "RepetitionSet"},
    "set_id": {"$ref": "#/$defs/ident"},
    "declared_order": {
      "type": "array",
      "minItems": 16,
      "maxItems": 512,
      "items": {"enum": ["OPTIMIZED_SERVER_ONLY_CONTROL", "Q_PIM_TREATMENT"]}
    },
    "order_digest": {"$ref": "#/$defs/sha256"},
    "aggregate_method": {"const": "SUM_ALL_PAIRS_V1"},
    "warmup_timelines": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeline_id", "record_sha256"],
        "properties": {
          "timeline_id": {"$ref": "#/$defs/ident"},
          "record_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "attempted_pairs": {"type": "integer", "minimum": 0, "maximum": 256},
    "pairs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_index", "control_timeline_id", "control_record_sha256",
                     "treatment_timeline_id", "treatment_record_sha256",
                     "first_executed_role", "status", "reason_code"],
        "properties": {
          "pair_index": {"$ref": "#/$defs/uint"},
          "control_timeline_id": {"$ref": "#/$defs/ident"},
          "control_record_sha256": {"$ref": "#/$defs/sha256"},
          "treatment_timeline_id": {"$ref": "#/$defs/ident"},
          "treatment_record_sha256": {"$ref": "#/$defs/sha256"},
          "first_executed_role": {
            "enum": ["OPTIMIZED_SERVER_ONLY_CONTROL", "Q_PIM_TREATMENT"]
          },
          "status": {"enum": ["OK", "FAILED"]},
          "reason_code": {"$ref": "#/$defs/ident"}
        }
      }
    },
    "scope": {"enum": ["GPU_BOARD", "SERVER_WALL"]},
    "instrument_kind": {
      "enum": ["NVML_BOARD", "RAPL_PACKAGE", "EXTERNAL_WALL_METER",
               "BMC_INPUT_POWER", "SYNTHETIC"]
    },
    "aggregate_result_label": {"const": "MEASUREMENT_INVALID"},
    "reason_code": {"$ref": "#/$defs/ident"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  }
}
