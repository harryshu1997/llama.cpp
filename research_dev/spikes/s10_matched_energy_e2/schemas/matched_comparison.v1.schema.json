{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s10-e2-matched-comparison-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "comparison_id",
    "control_timeline_id",
    "control_record_sha256",
    "treatment_timeline_id",
    "treatment_record_sha256",
    "repetition_set_digest",
    "order_digest",
    "scope",
    "instrument_kind",
    "matched_on",
    "control_energy_nj",
    "control_uncertainty_nj",
    "treatment_energy_nj",
    "treatment_uncertainty_nj",
    "control_lower_nj",
    "treatment_upper_nj",
    "conservative_margin_nj",
    "boundary_delta_nj",
    "server_wall_delta_nj",
    "phone_plus_external_break_even_budget_nj",
    "meets_ten_percent_gate",
    "result_label",
    "reason_code",
    "record_sha256"
  ],
  "$defs": {
    "ident": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uint": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sint": {"type": "integer", "minimum": -9007199254740991,
             "maximum": 9007199254740991},
    "nullable_sint": {
      "oneOf": [
        {"$ref": "#/$defs/sint"},
        {"type": "null"}
      ]
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "MatchedComparison"},
    "comparison_id": {"$ref": "#/$defs/ident"},
    "control_timeline_id": {"$ref": "#/$defs/ident"},
    "control_record_sha256": {"$ref": "#/$defs/sha256"},
    "treatment_timeline_id": {"$ref": "#/$defs/ident"},
    "treatment_record_sha256": {"$ref": "#/$defs/sha256"},
    "repetition_set_digest": {"$ref": "#/$defs/sha256"},
    "order_digest": {"$ref": "#/$defs/sha256"},
    "scope": {"enum": ["GPU_BOARD", "SERVER_WALL"]},
    "instrument_kind": {
      "enum": ["NVML_BOARD", "RAPL_PACKAGE", "EXTERNAL_WALL_METER",
               "BMC_INPUT_POWER", "SYNTHETIC"]
    },
    "matched_on": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_digest", "trace_digest", "slo_policy_digest",
                   "offered_work", "completed_work", "outcomes",
                   "included_rails", "excluded_rails", "board_uuids",
                   "clock_epoch_id", "effective_window_us"],
      "properties": {
        "workload_digest": {"$ref": "#/$defs/sha256"},
        "trace_digest": {"$ref": "#/$defs/sha256"},
        "slo_policy_digest": {"$ref": "#/$defs/sha256"},
        "offered_work": {"$ref": "#/$defs/uint"},
        "completed_work": {"$ref": "#/$defs/uint"},
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["met", "tardy", "rejected", "canceled"],
          "properties": {
            "met": {"$ref": "#/$defs/uint"},
            "tardy": {"$ref": "#/$defs/uint"},
            "rejected": {"$ref": "#/$defs/uint"},
            "canceled": {"$ref": "#/$defs/uint"}
          }
        },
        "included_rails": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/ident"}
        },
        "excluded_rails": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/ident"}
        },
        "board_uuids": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/ident"}
        },
        "clock_epoch_id": {"$ref": "#/$defs/ident"},
        "effective_window_us": {"$ref": "#/$defs/uint"}
      }
    },
    "control_energy_nj": {"$ref": "#/$defs/uint"},
    "control_uncertainty_nj": {"$ref": "#/$defs/uint"},
    "treatment_energy_nj": {"$ref": "#/$defs/uint"},
    "treatment_uncertainty_nj": {"$ref": "#/$defs/uint"},
    "control_lower_nj": {"$ref": "#/$defs/sint"},
    "treatment_upper_nj": {"$ref": "#/$defs/sint"},
    "conservative_margin_nj": {"$ref": "#/$defs/sint"},
    "boundary_delta_nj": {"$ref": "#/$defs/sint"},
    "server_wall_delta_nj": {"$ref": "#/$defs/nullable_sint"},
    "phone_plus_external_break_even_budget_nj": {
      "$ref": "#/$defs/nullable_sint"
    },
    "meets_ten_percent_gate": {"type": "boolean"},
    "result_label": {"const": "MEASUREMENT_INVALID"},
    "reason_code": {
      "enum": ["SYNTHETIC_NO_PHYSICAL_CLAIM", "PAIR_ONLY_NO_AGGREGATE_CLAIM"]
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"scope": {"const": "GPU_BOARD"}},
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "server_wall_delta_nj": {"type": "null"},
          "phone_plus_external_break_even_budget_nj": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"scope": {"const": "SERVER_WALL"}},
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "server_wall_delta_nj": {"$ref": "#/$defs/sint"},
          "phone_plus_external_break_even_budget_nj": {
            "$ref": "#/$defs/sint"
          }
        }
      }
    }
  ]
}
