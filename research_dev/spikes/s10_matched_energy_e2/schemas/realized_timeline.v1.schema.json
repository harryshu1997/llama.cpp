{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s10-e2-realized-timeline-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "timeline_id",
    "run_nonce",
    "role",
    "provenance",
    "policy_digest",
    "workload_digest",
    "trace_digest",
    "slo_policy_digest",
    "route_schedule_digest",
    "offered_work",
    "completed_work",
    "outcomes",
    "clock_epoch_id",
    "marker_start_us",
    "marker_end_us",
    "window_start_us",
    "window_end_us",
    "scope",
    "instrument_kind",
    "instrument_identity",
    "instrument_label",
    "synchronization",
    "board_uuids",
    "included_rails",
    "excluded_rails",
    "execution_artifact_id",
    "execution_artifact_sha256",
    "execution_artifact_path",
    "raw_artifact_id",
    "raw_artifact_sha256",
    "raw_artifact_path",
    "paid_payload_sha256",
    "normalizer_digest",
    "sample_count",
    "independent_updates",
    "max_gap_us",
    "energy_nj",
    "uncertainty_nj",
    "source_revision",
    "build_revision",
    "device_identity",
    "status",
    "reason_code",
    "record_sha256"
  ],
  "$defs": {
    "ident": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "RealizedTimeline"
    },
    "timeline_id": {
      "$ref": "#/$defs/ident"
    },
    "run_nonce": {
      "$ref": "#/$defs/ident"
    },
    "role": {
      "enum": [
        "OPTIMIZED_SERVER_ONLY_CONTROL",
        "Q_PIM_TREATMENT"
      ]
    },
    "provenance": {
      "enum": [
        "MEASURED",
        "SYNTHETIC"
      ]
    },
    "policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "workload_digest": {
      "$ref": "#/$defs/sha256"
    },
    "trace_digest": {
      "$ref": "#/$defs/sha256"
    },
    "slo_policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "route_schedule_digest": {
      "$ref": "#/$defs/sha256"
    },
    "offered_work": {
      "$ref": "#/$defs/uint"
    },
    "completed_work": {
      "$ref": "#/$defs/uint"
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "met",
        "tardy",
        "rejected",
        "canceled"
      ],
      "properties": {
        "met": {
          "$ref": "#/$defs/uint"
        },
        "tardy": {
          "$ref": "#/$defs/uint"
        },
        "rejected": {
          "$ref": "#/$defs/uint"
        },
        "canceled": {
          "$ref": "#/$defs/uint"
        }
      }
    },
    "clock_epoch_id": {
      "$ref": "#/$defs/ident"
    },
    "marker_start_us": {
      "$ref": "#/$defs/uint"
    },
    "marker_end_us": {
      "$ref": "#/$defs/uint"
    },
    "window_start_us": {
      "$ref": "#/$defs/uint"
    },
    "window_end_us": {
      "$ref": "#/$defs/uint"
    },
    "scope": {
      "enum": [
        "GPU_BOARD",
        "SERVER_WALL"
      ]
    },
    "instrument_kind": {
      "enum": [
        "NVML_BOARD",
        "RAPL_PACKAGE",
        "EXTERNAL_WALL_METER",
        "BMC_INPUT_POWER",
        "SYNTHETIC"
      ]
    },
    "instrument_identity": {
      "$ref": "#/$defs/ident"
    },
    "instrument_label": {
      "type": "string",
      "minLength": 0,
      "maxLength": 256
    },
    "synchronization": {
      "enum": [
        "MONOTONIC_SHARED",
        "NTP",
        "PTP",
        "NONE"
      ]
    },
    "board_uuids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ident"
      }
    },
    "included_rails": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ident"
      },
      "minItems": 1
    },
    "excluded_rails": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ident"
      }
    },
    "execution_artifact_id": {
      "$ref": "#/$defs/ident"
    },
    "execution_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_artifact_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "raw_artifact_id": {
      "$ref": "#/$defs/ident"
    },
    "raw_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "raw_artifact_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "paid_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "normalizer_digest": {
      "$ref": "#/$defs/sha256"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 1000000
    },
    "independent_updates": {
      "$ref": "#/$defs/uint"
    },
    "max_gap_us": {
      "$ref": "#/$defs/uint"
    },
    "energy_nj": {
      "$ref": "#/$defs/uint"
    },
    "uncertainty_nj": {
      "$ref": "#/$defs/uint"
    },
    "source_revision": {
      "$ref": "#/$defs/ident"
    },
    "build_revision": {
      "$ref": "#/$defs/ident"
    },
    "device_identity": {
      "$ref": "#/$defs/ident"
    },
    "status": {
      "enum": [
        "OK",
        "FAILED",
        "INELIGIBLE"
      ]
    },
    "reason_code": {
      "$ref": "#/$defs/ident"
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256"
    }
  }
}
