+    def test_led_candidate_carries_the_helper_shard_and_its_geometry(self) -> None:
+        # gap 12 (2026-10-26): the anchored helper's static slice is the route's one phone shard, so the desktop
+        # ticket's helper envelope, the proofs and the shard-geometry validation all have something to bind to
+        catalog = self.catalog(True, independent=False)
+        scheduler = UnifiedScheduler.for_runtime_discovery("enforce")
+        scheduler.register_runtime_capabilities(catalog)
+        scheduler.register_model_manifest(self.model)
+        snapshot = hot(h.snapshot(self.model, catalog), "physical:" + h.OP15)
+        values = scheduler.generate_automated_candidates(h.request("ws23-shard"), self.model.model_id, snapshot)
