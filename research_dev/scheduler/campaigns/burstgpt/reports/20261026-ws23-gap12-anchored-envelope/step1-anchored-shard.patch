+            self.assertEqual(parameters["phone_session_count"], 1)
+            self.assertEqual(parameters["phone_shard_set_geometry_sha256"], parameters["ffn_resident_geometry_sha256"])
+            shards = plan.execution_contract.phone_shards
+            self.assertEqual(len(shards), 1)
