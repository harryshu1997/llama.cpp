+def anchored_helper_shards(
+    adapter_parameters: Mapping[str, object],
+    manifest: ModelManifest,
+) -> tuple[RuntimePhoneShard, ...]:
+    """WS23 gap 12: the synthetic phone shard of a helper-led route (its static co-helper slice).
+
+    The anchored helper has no HTP session, so no ``_FfnResidentEnvelope`` produces shards for it; the desktop
+    ticket's helper envelope, the physical proofs (``phone_calls_by_session``) and the shard-geometry validation
+    all key on ``contract.phone_shards``. One shard per anchored helper: its TCP worker session id and endpoint,
+    its whole declared layer mask at full width, the geometry ``anchored_resident_parameters`` computed.
+    Empty for every other route."""
+    if adapter_parameters.get(STATIC_HELPER_ANCHOR_PARAMETER) != 1:
+        return ()
+    declaration = anchored_co_helper_declaration(adapter_parameters)
+    device_id = adapter_parameters.get("phone_device_id")
+    geometry = adapter_parameters.get("ffn_resident_geometry_sha256")
+    if declaration is None or type(device_id) is not str or type(geometry) is not str:
+        return ()
+    rows = [row for row in declaration.helpers if row.device_id == device_id]
+    if len(rows) != 1 or rows[0].layer_mask <= 0:
+        return ()
+    row = rows[0]
+    # the shard's own geometry differs from the shard-set geometry on purpose: a residency component identity
+    # lists both and requires them distinct (as the per-session geometries of an HTP layout are)
+    shard_geometry = canonical_sha256({
+        "device_id": device_id, "session_id": row.session_id, "layer_mask": row.layer_mask,
+        "columns": manifest.feed_forward_length, "shard_sha256": row.shard_sha256,
+        "shard_set_geometry_sha256": geometry, "kind": "anchored-helper-shard-v1",
+    })
+    return (RuntimePhoneShard(
+        session_id=row.session_id,
+        endpoint=row.endpoint,
+        layer_mask=row.layer_mask,
+        maximum_columns=manifest.feed_forward_length,
+        resident_bytes=row.resident_bytes,
+        resident_geometry_sha256=shard_geometry,
+        operator_plan_sha256=row.shard_sha256,
+        artifact_sha256=manifest.artifact_sha256,
+        session_generation=1,
+    ),)
